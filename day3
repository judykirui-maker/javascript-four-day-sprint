  if (!actionButton) {
    return;
  }

  if (actionButton.dataset.action === "delete") {
  const taskId = Number(actionButton.closest("li").dataset.taskId);

  tasks = tasks.filter(function (task) {
    return task.id !== taskId;
  });
  
 saveTasks(); 

  renderTasks();
}
});
